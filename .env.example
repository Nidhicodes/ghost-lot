# Server-side only. Never expose to the browser (no VITE_ prefix).
# Any OpenAI-compatible vision endpoint. The live demo uses Gemini:
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_ID=gemini-3.5-flash-lite
MODEL_API_KEY=
# Groq also works: MODEL_BASE_URL=https://api.groq.com/openai/v1 MODEL_ID=qwen/qwen3.8-27b
# (GROQ_API_KEY is accepted as a fallback for MODEL_API_KEY)
# Free-tier guardrails (Requirement 7a)
READ_BUDGET_PER_DAY=70
LIVE_LOOKUPS_PER_IP_PER_DAY=2
# Shared store for the budget, cache and rate limit (Upstash REST, read/write token). Unset = in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
