{
  "name": "ghost-lot",
  "version": "0.1.0",
  "private": true,
  "description": "What used to haunt your address: historic fire-insurance maps read for buried hazards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build-index": "tsx scripts/build-index/main.ts"
  },
  "dependencies": {
    "@allmaps/annotation": "1.0.0-beta.38",
    "@allmaps/maplibre": "1.0.0-beta.44",
    "@allmaps/project": "1.0.0-beta.10",
    "flatbush": "4.7.0",
    "maplibre-gl": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@allmaps/types": "1.0.0-beta.24",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/node": "32.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.23.15",
    "fast-check": "4.10.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
